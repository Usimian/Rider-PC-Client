.vscode/browse.vc*
*.pyc
__pycache__/
*.pyo
*.pyd

# Large model files - see README "External assets"
*.pt
# Backup archives
*.tar.gz
# Flash / servo dumps (transient, regenerable)
*.bin
# ...except the known-good prebuilt firmware images, which we keep on purpose
!firmware/prebuilt/*.bin
# ...but NOT the balance fw: it changes every firmware commit and is always flashed
# from source (pio run -t upload), so a snapshot here just goes stale. Build it.
firmware/prebuilt/rider_balance_fw.bin
# Diagnostic captures + plots (transient, regenerable from the robot)
*.csv
*.png
# Training run logs (transient)
*.log
# PlatformIO build output
.pio/

